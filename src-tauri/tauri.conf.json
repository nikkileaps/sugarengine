{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sugarengine",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:7777",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sugarengine",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../src/plugins/sugaragent/runtime/bundle/bin/**/*",
      "../src/plugins/sugaragent/runtime/bundle/models/**/*",
      "../src/plugins/sugaragent/runtime/bundle/bundle.lock.json",
      "../src/plugins/sugaragent/lore/generated/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
