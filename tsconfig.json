{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src", "packages"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.mts",
    "src/**/*.spec.ts",
    "src/plugins/sugaragent/eval/**",
    "src/plugins/sugaragent/command-api.ts",
    "src/plugins/sugaragent/sim/cli.ts",
    "src/plugins/sugaragent/eval/cli.ts",
    "src/plugins/sugaragent/lore/ingest-cli.ts",
    "src/plugins/sugaragent/runtime/bundle-cli.ts",
    "src/plugins/sugaragent/authoring/pack-cli.ts",
    "src/plugins/sugaragent/authoring/artifacts.ts",
    "src/plugins/sugaragent/dialogue/scenario-orchestration.ts",
    "src/plugins/sugaragent/dialogue/fallback-policy.ts",
    "src/plugins/sugaragent/lore/lore-lib.ts",
    "src/plugins/sugaragent/simulation/cadence.ts",
    "src/plugins/sugaragent/runtime/model-profiles.ts",
    "src/plugins/sugaragent/session/runtime.ts",
    "src/plugins/sugaragent/session/core/**",
    "src/plugins/sugaragent/session/providers/**",
    "src/plugins/sugaragent/tools/**",
    "src/plugins/sugaragent/test-utils/**"
  ]
}
