  {
    "chunkId": "lore.locations.towns.town.earendale#earendale",
    "pageId": "lore.locations.towns.town.earendale",
    "title": "Earendale",
    "canonLevel": "hard",
    "sourceFile": "locations/towns/town.earendale.md",
    "sourceRepo": "git@github.com:nikkileaps/rackwick-lore.git",
    "sourceCommit": "17c297a695d086d7ce3e61438b3fc6970ec9068b",
    "sourceRef": "refs/heads/main",
    "sectionHeading": "Earendale",
    "content": "A town located on a floating chunk of land that broke off from the ear of the Great Head. Reachable only by special train. A small town with a populace of 57 permanent residents. The Wordlark Hollow Resort and Spa is located just outside the town. In its peak season the population of the isle swells to hundreds due to the visitors coming and going from the resort. Known for the wordlarks that flit around its hot springs. People visit it from across the Great Head to relax in the waters of the Wordlark Hollow Resort and Spa in the hope that a wordlark to visit them and help them resolve a matter of the heart.",
    "summary": "A town located on a floating chunk of land that broke off from the ear of the Great Head.",
